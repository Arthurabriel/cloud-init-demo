SPIRE_SERVER_SOCKET=/run/spire/server/private/api.sock
SPIRE_SERVER_SOCKET_DIR=/run/spire/server/private
SPIRE_AGENT_SOCKET=/run/spire/agent/agent.sock
SPIRE_AGENT_SOCKET_DIR=/run/spire/agent
SPIRE_AGENT_BINARY=/opt/spire/bin/spire-agent
SPIRE_SERVER_BINARY=/opt/spire/bin/spire-server
SPIRE_AGENT_JOIN_TOKEN_FILE=/var/lib/spire/agent/join-token

SPIRE_EVIDENCE_ADAPTER_IMAGE=arthurgb469/spire-evidence-adapter:0.1.10
SPIRE_EVIDENCE_ADAPTER_CONTAINER_NAME=spire-evidence-adapter

A2A_WORKERS_IMAGE=arthurgb469/a2a-workers:0.1.1
A2A_WORKERS_IMAGE_CONFIG_DIGEST=
A2A_WORKLOAD_LABEL_KEY=spire.workload
A2A_SPIFFE_AUDIENCE=a2a-orchestrator

A2A_WORKER_AUTOGEN_CONTAINER_NAME=a2a-worker-autogen
A2A_WORKER_AUTOGEN_LABEL_VALUE=a2a-worker-autogen
A2A_WORKER_AUTOGEN_COMMAND=worker_autogen/server.py
A2A_WORKER_AUTOGEN_UID=10001
A2A_WORKER_AUTOGEN_PORT=8002

A2A_WORKER_CREWAI_CONTAINER_NAME=a2a-worker-crewai
A2A_WORKER_CREWAI_LABEL_VALUE=a2a-worker-crewai
A2A_WORKER_CREWAI_COMMAND=worker_crewai/server.py
A2A_WORKER_CREWAI_UID=10002
A2A_WORKER_CREWAI_PORT=8001
