# Static defaults for the OpenStack Nested SPIRE first boot scripts.
# Instance-specific values belong in /etc/pgid-authority/nested.env.

TRUST_DOMAIN=example.org

ROOT_SPIRE_BIND_ADDRESS=0.0.0.0
ROOT_SPIRE_PORT=8081

TRUSTED_SPIRE_SERVER=
TRUSTED_SPIRE_PORT=8081

AUTHORITY_SPIRE_BIND_ADDRESS=127.0.0.1
AUTHORITY_SPIRE_PORT=8082

TRUSTED_ROOT_SERVER_CONFIG=/etc/spire/trusted-root/server.conf
TRUSTED_ROOT_SERVER_DATA_DIR=/var/lib/spire/trusted-root/server
TRUSTED_ROOT_SERVER_SOCKET=/run/spire/trusted-root/server/private/api.sock

UPSTREAM_AGENT_CONFIG=/etc/spire/upstream-agent/agent.conf
UPSTREAM_AGENT_DATA_DIR=/var/lib/spire/upstream-agent
UPSTREAM_AGENT_SOCKET=/run/spire/upstream-agent/public/api.sock
UPSTREAM_AGENT_JOIN_TOKEN_FILE=/etc/pgid-authority/upstream-agent.join-token

AUTHORITY_SERVER_CONFIG=/etc/spire/authority-server/server.conf
AUTHORITY_SERVER_DATA_DIR=/var/lib/spire/authority-server
AUTHORITY_SERVER_SOCKET=/run/spire/authority-server/private/api.sock
AUTHORITY_SERVER_SPIFFE_ID=

AUTHORITY_AGENT_CONFIG=/etc/spire/authority-agent/agent.conf
AUTHORITY_AGENT_DATA_DIR=/var/lib/spire/authority-agent
AUTHORITY_AGENT_SOCKET=/run/spire/authority-agent/public/api.sock
AUTHORITY_AGENT_JOIN_TOKEN_FILE=/var/lib/spire/authority-agent/join-token

NESTED_FIRSTBOOT_STATE_DIR=/var/lib/pgid-authority
NESTED_FIRSTBOOT_LOG_DIR=/var/log/authority
