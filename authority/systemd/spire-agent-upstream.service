[Unit]
Description=Upstream SPIRE Agent for Nested Authority
Documentation=https://spiffe.io/docs/latest/architecture/nested/readme/
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/spire/upstream-agent/agent.conf
StartLimitIntervalSec=10min
StartLimitBurst=6

[Service]
Type=simple
User=spire-agent
Group=spire-agent

ExecStart=/usr/local/sbin/run-spire-agent-upstream

Restart=on-failure
RestartSec=10

RuntimeDirectory=spire/upstream-agent/public
RuntimeDirectoryMode=0755

UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=authority-core.target
