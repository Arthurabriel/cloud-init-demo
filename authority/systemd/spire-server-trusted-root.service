[Unit]
Description=Trusted Root SPIRE Server
Documentation=https://spiffe.io/docs/latest/architecture/nested/readme/
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/spire/trusted-root/server.conf
StartLimitIntervalSec=10min
StartLimitBurst=6

[Service]
Type=simple
User=spire-server
Group=spire-server

ExecStart=/opt/spire/bin/spire-server run \
    -config /etc/spire/trusted-root/server.conf

Restart=on-failure
RestartSec=10

RuntimeDirectory=spire/trusted-root/server/private
RuntimeDirectoryMode=0750

UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=trusted-root.target
